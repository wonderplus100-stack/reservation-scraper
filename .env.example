# このファイルをコピーして .env を作成し、実際の値を入れてください。
# .env は .gitignore 対象なので絶対にコミットしないでください。
# GitHub Actionsで動かす際は、同じ変数名で Settings > Secrets and variables > Actions に登録します。

# --- Googleスプレッドシート(データ保存先。プライベート共有のシートを用意し、
#     サービスアカウントのメールアドレスを「編集者」として共有してください) ---
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ... }

# --- Googleフォーム(回答が書き込まれる連携先スプレッドシートのID) ---
# NAME_COLUMN_PATTERN / EVENT_COLUMN_PATTERN は列見出しの完全一致ではなく
# 部分一致で指定する(同じ質問が複数セクションにあると回答シート上は同名列が
# 複数できるため、部分一致で該当列すべてを見て最初に値が入っているものを使う)。
FORM_1_ACCOUNT_LABEL=フォーム1
FORM_1_SPREADSHEET_ID=
FORM_1_SHEET_NAME=フォームの回答 1
FORM_1_NAME_COLUMN_PATTERN=お名前
FORM_1_EVENT_COLUMN_PATTERN=参加希望日

FORM_2_ACCOUNT_LABEL=フォーム2
FORM_2_SPREADSHEET_ID=
FORM_2_SHEET_NAME=フォームの回答 1
FORM_2_NAME_COLUMN_PATTERN=お名前
FORM_2_EVENT_COLUMN_PATTERN=参加希望日時

# --- こくちーずPRO (Phase 2: まず wonderplus100@gmail.com のみ) ---
KOKUCHPRO_1_ACCOUNT_LABEL=こくちーずPRO(wonderplus100)
KOKUCHPRO_1_EMAIL=wonderplus100@gmail.com
KOKUCHPRO_1_PASSWORD=
KOKUCHPRO_1_TOTP_SECRET=

# もう一方のこくちーずPROアカウントはPhase 5まで未使用(値を入れても run.mjs 側で無効化されています)
KOKUCHPRO_2_ACCOUNT_LABEL=こくちーずPRO(2つ目)
KOKUCHPRO_2_EMAIL=
KOKUCHPRO_2_PASSWORD=
KOKUCHPRO_2_TOTP_SECRET=

# --- Peatix (Phase 3) ---
PEATIX_1_ACCOUNT_LABEL=Peatix(1つ目)
PEATIX_1_EMAIL=
PEATIX_1_PASSWORD=
PEATIX_1_TOTP_SECRET=

PEATIX_2_ACCOUNT_LABEL=Peatix(2つ目)
PEATIX_2_EMAIL=
PEATIX_2_PASSWORD=
PEATIX_2_TOTP_SECRET=

# --- つなげーと (Phase 4) ---
TUNAGATE_1_ACCOUNT_LABEL=つなげーと
TUNAGATE_1_EMAIL=
TUNAGATE_1_PASSWORD=
TUNAGATE_1_TOTP_SECRET=

# --- 動作設定 ---
# ブラウザを表示してデバッグしたい場合は false にする(GitHub Actions上では常にtrue)
HEADLESS=true
